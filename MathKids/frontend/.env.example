VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Firebase Authentication (default email/password signup/login) and Analytics configuration.
# Authentication needs API_KEY, AUTH_DOMAIN, PROJECT_ID and APP_ID, plus the matching
# FIREBASE_PROJECT_ID in backend/.env. Analytics also needs MEASUREMENT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
