PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DB_SERVER=TUSN
DB_INSTANCE=MSSQLSERVER03
DB_PORT=
DB_NAME=MathKids
DB_USER=sa
DB_PASSWORD=123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Email OTP registration. For Gmail, use an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM="MathKids <your-sender@gmail.com>"
OTP_HASH_SECRET=replace-with-a-long-random-secret
GEMINI_API_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Keep the API key only in backend/.env. Never add it to VITE_* variables or frontend files.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=your_sandbox_merchant_id
SEPAY_SECRET_KEY=your_sandbox_secret_key
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Bug reports: backend forwards reports to a Google Apps Script Web App that appends them to one Google Doc.
BUG_REPORT_WEBHOOK_URL=
BUG_REPORT_WEBHOOK_SECRET=change-this-bug-report-secret